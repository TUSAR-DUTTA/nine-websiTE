# =========================================================
# SOCIAL BAG WORKING AUTOMATION ENVIRONMENT CONFIGURATION
# =========================================================

# 1. DATABASE CREDENTIALS (Choose either DATABASE_URL or individual params)
# Supported: Supabase, Neon, AWS RDS, Railway, Local PostgreSQL
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Alternatively individual PostgreSQL params:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=yourpassword
# PGDATABASE=nineterminal

# 2. TWITTER / X SCRAPING SESSION (Bypasses Login Walls)
# To get these in 10 seconds:
# 1. Open x.com in Chrome where you are logged in
# 2. Press F12 -> Application tab -> Cookies -> https://x.com
# 3. Copy the values of "auth_token" and "ct0"
TWITTER_AUTH_TOKEN=your_auth_token_cookie_here
TWITTER_CT0=your_ct0_cookie_here

# 3. RUNNER & APP SETTINGS
HEADLESS=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=super_secret_cron_key_99
